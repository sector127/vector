# ==========================================================================
# VECTOR HUB — TELEGRAM BOT NOTIFICATIONS CONFIGURATION
# ==========================================================================

# 1. Serverless Environment Variables (Recommended for Vercel deployment):
# Set these in your Vercel Project Settings -> Environment Variables
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id

# 2. Client-side Environment Variables (Optional for static/local direct fallback):
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id
